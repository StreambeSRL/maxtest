# ---- Autenticación con Anthropic (elegí UNA; si no usás API key, no dejes la línea vacía) ----
# (1) API key de https://console.anthropic.com
#ANTHROPIC_API_KEY=sk-ant-api03-...
# (2) Login interactivo en esta máquina: `ant auth login` (no requiere variables)
# (3) Workload Identity Federation (servidores / CI con proveedor OIDC):
#ANTHROPIC_FEDERATION_RULE_ID=fdrl_...
#ANTHROPIC_ORGANIZATION_ID=<uuid de la organización>
#ANTHROPIC_SERVICE_ACCOUNT_ID=svac_...
#ANTHROPIC_IDENTITY_TOKEN_FILE=C:\ruta\al\jwt.txt   # o ANTHROPIC_IDENTITY_TOKEN=<jwt>
#ANTHROPIC_WORKSPACE_ID=wrkspc_...                  # solo si la regla cubre varios workspaces

# Modelo usado por los testers
TESTER_MODEL=claude-opus-5
# Esfuerzo de razonamiento: low | medium | high | xhigh | max
TESTER_EFFORT=medium
# Tope de turnos por corrida
TESTER_MAX_TURNS=200
# Puerto del servidor
PORT=4321
# true = ver los navegadores reales en el escritorio (usa más recursos)
HEADED=false
